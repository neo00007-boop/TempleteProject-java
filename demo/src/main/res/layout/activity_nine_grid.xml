<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/common_window_background_color"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/x40"
        android:paddingTop="@dimen/x30"
        android:paddingEnd="@dimen/x40"
        android:paddingBottom="@dimen/x10"
        android:text="点击格子预览（MediaPickerUtil）；&gt;9 张末格显示剩余「n+」"
        android:textColor="@color/cl_666"
        android:textSize="@dimen/x32"
        tools:ignore="HardcodedText" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/x40"
        android:paddingEnd="@dimen/x40"
        android:paddingBottom="@dimen/x60">

        <LinearLayout
            android:id="@+id/llNineGridSamples"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
