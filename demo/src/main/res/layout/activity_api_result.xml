<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/common_window_background_color"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/x40">

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvDetail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x140"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="对象 data"
            android:textColor="@color/white"
            android:textSize="@dimen/x40"
            app:shape_radius="@dimen/x70"
            app:shape_solidColor="@color/common_accent_color"
            app:shape_textColor="@color/white"
            tools:ignore="HardcodedText" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvList"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x140"
            android:layout_marginTop="@dimen/x30"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="列表 data"
            android:textColor="@color/white"
            android:textSize="@dimen/x40"
            app:shape_radius="@dimen/x70"
            app:shape_solidColor="@color/common_accent_color"
            app:shape_textColor="@color/white"
            tools:ignore="HardcodedText" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvDelete"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x140"
            android:layout_marginTop="@dimen/x30"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="无 data 的成功"
            android:textColor="@color/white"
            android:textSize="@dimen/x40"
            app:shape_radius="@dimen/x70"
            app:shape_solidColor="@color/common_accent_color"
            app:shape_textColor="@color/white"
            tools:ignore="HardcodedText" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x140"
            android:layout_marginTop="@dimen/x30"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="data 为空"
            android:textColor="@color/white"
            android:textSize="@dimen/x40"
            app:shape_radius="@dimen/x70"
            app:shape_solidColor="@color/common_accent_color"
            app:shape_textColor="@color/white"
            tools:ignore="HardcodedText" />

        <com.hjq.shape.view.ShapeTextView
            android:id="@+id/tvFail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x140"
            android:layout_marginTop="@dimen/x30"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="业务失败"
            android:textColor="@color/white"
            android:textSize="@dimen/x40"
            app:shape_radius="@dimen/x70"
            app:shape_solidColor="@color/common_accent_color"
            app:shape_textColor="@color/white"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x40"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/x8"
            android:text="点上面的按钮。请求走 Retrofit，响应用本地样例 JSON。"
            android:textColor="@color/cl_666"
            android:textSize="@dimen/x32"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</ScrollView>
