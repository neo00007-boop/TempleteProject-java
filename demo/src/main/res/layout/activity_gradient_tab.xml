<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <com.flyco.tablayout.GradientSlidingTabLayout
        android:id="@+id/xtablayout_info"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="6dp"
        android:orientation="horizontal"
        app:gst_indicator_end_color="@color/color_end_tab_layout"
        app:gst_indicator_gradient_direction="VERTICAL"
        app:gst_indicator_start_color="@color/color_start_tab_layout"
        app:tl_indicator_corner_radius="21dp"
        app:tl_indicator_style="BLOCK"
        app:tl_tab_padding="11dp"
        app:tl_textBold="true"
        app:tl_textScale="1.2"
        app:tl_textSelectColor="@color/white"
        app:tl_textUnselectColor="@color/cl_797979"
        app:tl_textsize="14sp" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
