<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llPostAudioPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/common_window_background_color"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/x40"
        android:paddingTop="@dimen/x30"
        android:paddingEnd="@dimen/x40"
        android:paddingBottom="@dimen/x10"
        android:textColor="@color/cl_666"
        android:textSize="@dimen/x32"
        tools:ignore="HardcodedText"
        tools:text="波形由 url 确定性生成；同时只能播一条" />

    <TextView
        android:id="@+id/tvCustomStyleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/x40"
        android:paddingEnd="@dimen/x40"
        android:text="自定义属性示例（pav_*）"
        android:textColor="@color/cl_333333"
        android:textSize="@dimen/x32"
        tools:ignore="HardcodedText" />

    <com.lib.base.ui.widget.audio.PostAudioView
        android:id="@+id/postAudioCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x30"
        android:layout_marginTop="@dimen/x16"
        android:layout_marginEnd="@dimen/x30"
        app:pav_bgColor="#FFF3F0"
        app:pav_cornerRadius="@dimen/x32"
        app:pav_durationGravity="start"
        app:pav_durationTextColor="#FB7299"
        app:pav_durationTextSize="@dimen/x26"
        app:pav_loadingTint="#FFFFFF"
        app:pav_paddingBottom="@dimen/x24"
        app:pav_paddingEnd="@dimen/x28"
        app:pav_paddingStart="@dimen/x28"
        app:pav_paddingTop="@dimen/x24"
        app:pav_playBtnColor="#FB7299"
        app:pav_playBtnSize="@dimen/x100"
        app:pav_playIconPadding="@dimen/x26"
        app:pav_waveAreaMarginStart="@dimen/x24"
        app:pav_waveBarCornerRadius="@dimen/x4"
        app:pav_waveBarWidthRatio="0.7"
        app:pav_waveBufferColor="#80FB7299"
        app:pav_waveHeight="@dimen/x80"
        app:pav_waveMarginTop="@dimen/x12"
        app:pav_waveMinBarHeight="@dimen/x6"
        app:pav_wavePlayedColor="#FB7299"
        app:pav_waveRemainColor="#FFD6E7" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAudioList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/x30"
        android:paddingTop="@dimen/x20"
        android:paddingEnd="@dimen/x30"
        android:paddingBottom="@dimen/x40"
        tools:listitem="@layout/item_post_audio" />
</LinearLayout>
