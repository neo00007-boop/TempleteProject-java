<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--占位图-->
    <declare-styleable name="HolderView">
        <attr name="srcLoadingResource" format="reference" />
        <attr name="srcNoDataResource" format="reference" />
        <attr name="srcErrorResource" format="reference" />
        <attr name="strLoading" format="string" />
        <attr name="strNoData" format="string" />
        <attr name="strError" format="string" />
        <!-- loading 样式：progress 转圈；shimmer 骨架；none 无 loading UI -->
        <attr name="holderLoadingMode">
            <enum name="progress" value="0" />
            <enum name="shimmer" value="1" />
            <enum name="none" value="2" />
        </attr>
        <attr name="holderShimmerLayout" format="reference" />
    </declare-styleable>

    <declare-styleable name="ShimmerView">
        <!-- 直接指定骨架布局；优先于 shimmerType -->
        <attr name="shimmerLayout" format="reference" />
        <attr name="shimmerType">
            <enum name="list" value="0" />
            <enum name="grid" value="1" />
        </attr>
        <attr name="shimmerAutoStart" format="boolean" />
    </declare-styleable>
    <!--播放按钮-->
    <declare-styleable name="PlayButton">
        <!-- 线条颜色 -->
        <attr name="pb_lineColor" format="color" />
        <!-- 线条大小 -->
        <attr name="pb_lineSize" format="integer" />
        <!-- 动画时间 -->
        <attr name="pb_animDuration" format="integer" />
    </declare-styleable>
    <!--TitleBar-->
    <declare-styleable name="TitleBar">
        <attr name="barStatuesVisible" format="boolean" />
        <attr name="barInitModel">
            <!--默认不做初始化-->
            <enum name="initLater" value="-1" />
            <!--blue title theme-->
            <enum name="initBlueTheme" value="0" />
            <!--white title theme-->
            <enum name="initWhiteTheme" value="1" />
        </attr>
        <attr name="barBackStr" format="string" />
        <attr name="barBackVisible" format="boolean" />
        <attr name="barBackArrowVisible" format="boolean" />
        <attr name="barTitleStr" format="string" />
        <attr name="barRightIconResource" format="reference" />
    </declare-styleable>

    <!-- 九宫格图片 -->
    <declare-styleable name="NineGridImageView">
        <attr name="singleImgSize" format="dimension" />
        <attr name="imgGap" format="dimension" />
        <attr name="maxSize" format="integer" />
        <attr name="showStyle">
            <enum name="grid" value="0" />
            <enum name="fill" value="1" />
        </attr>
        <!-- 图片圆角（dimension → px） -->
        <attr name="ngiv_cornerRadius" format="dimension" />
        <!-- 图片蒙层颜色（color，透明/alpha=0 无蒙层） -->
        <attr name="ngiv_maskColor" format="color" />
        <!-- 超 maxSize 末格图片蒙层颜色 -->
        <attr name="ngiv_moreMaskColor" format="color" />
        <!-- n+ 字号 -->
        <attr name="ngiv_moreTextSize" format="dimension" />
        <!-- n+ 字色 -->
        <attr name="ngiv_moreTextColor" format="color" />
        <!-- n+ 背景色 -->
        <attr name="ngiv_moreTextBgColor" format="color" />
        <!-- n+ 背景圆角 -->
        <attr name="ngiv_moreTextCornerRadius" format="dimension" />
        <!-- n+ 右下外边距：右边 -->
        <attr name="ngiv_moreMarginEnd" format="dimension" />
        <!-- n+ 右下外边距：下边 -->
        <attr name="ngiv_moreMarginBottom" format="dimension" />
        <!-- n+ 内边距：左右 -->
        <attr name="ngiv_morePaddingHorizontal" format="dimension" />
        <!-- n+ 内边距：上下 -->
        <attr name="ngiv_morePaddingVertical" format="dimension" />
    </declare-styleable>

    <!-- 哔站标题式折叠 TextView：左文字右箭头，不足一行隐藏箭头 -->
    <declare-styleable name="FoldTextView">
        <attr name="ctv_text" format="string|reference" />
        <attr name="ctv_textSize" format="dimension" />
        <attr name="ctv_textColor" format="color" />
        <!-- 折叠行最小高度 / 间隙高度 -->
        <attr name="ctv_gapHeight" format="dimension" />
        <!-- 折叠按钮边长 -->
        <attr name="ctv_foldIconSize" format="dimension" />
        <!-- 收起态箭头 -->
        <attr name="ctv_foldIconSrc" format="reference" />
        <!-- 展开态箭头；未设置则对 foldIconSrc 旋转 180° -->
        <attr name="ctv_foldIconExpandSrc" format="reference" />
        <!-- 文字与箭头间距 -->
        <attr name="ctv_iconTextGap" format="dimension" />
        <!-- 是否默认展开，默认 false -->
        <attr name="ctv_expanded" format="boolean" />
    </declare-styleable>

    <!-- 帖子音频条：整体 / 播放钮 / 时长 / 波形均可 XML 配置 -->
    <declare-styleable name="PostAudioView">
        <!-- 整体背景（drawable/color）；优先于 pav_bgColor -->
        <attr name="pav_background" format="reference|color" />
        <!-- 整体纯色背景；配合 pav_cornerRadius 生成圆角 -->
        <attr name="pav_bgColor" format="color" />
        <attr name="pav_cornerRadius" format="dimension" />
        <attr name="pav_paddingStart" format="dimension" />
        <attr name="pav_paddingTop" format="dimension" />
        <attr name="pav_paddingEnd" format="dimension" />
        <attr name="pav_paddingBottom" format="dimension" />

        <!-- 播放按钮 -->
        <attr name="pav_playBtnSize" format="dimension" />
        <!-- 按钮背景（drawable/color）；优先于 pav_playBtnColor -->
        <attr name="pav_playBtnBackground" format="reference|color" />
        <!-- 圆形纯色按钮底色 -->
        <attr name="pav_playBtnColor" format="color" />
        <attr name="pav_playIcon" format="reference" />
        <attr name="pav_pauseIcon" format="reference" />
        <attr name="pav_playIconPadding" format="dimension" />
        <attr name="pav_loadingTint" format="color" />

        <!-- 波形区布局 -->
        <attr name="pav_waveAreaMarginStart" format="dimension" />
        <attr name="pav_waveHeight" format="dimension" />
        <attr name="pav_waveMarginTop" format="dimension" />
        <!-- 已播放 / 已缓冲 / 未播放 柱色 -->
        <attr name="pav_wavePlayedColor" format="color" />
        <attr name="pav_waveBufferColor" format="color" />
        <attr name="pav_waveRemainColor" format="color" />
        <attr name="pav_waveMinBarHeight" format="dimension" />
        <attr name="pav_waveBarCornerRadius" format="dimension" />
        <!-- 柱宽占槽宽比例 0~1，默认 0.62 -->
        <attr name="pav_waveBarWidthRatio" format="float" />

        <!-- 时长文字 -->
        <attr name="pav_durationTextSize" format="dimension" />
        <attr name="pav_durationTextColor" format="color" />
        <attr name="pav_durationGravity">
            <enum name="start" value="0" />
            <enum name="end" value="1" />
            <enum name="center" value="2" />
        </attr>
    </declare-styleable>

    <!-- 分格验证码：单隐式输入，支持粘贴 / setCode 赋值 / 系统短信填充 -->
    <declare-styleable name="VerificationCodeView">
        <attr name="vcv_et_number" format="integer" />
        <attr name="vcv_et_inputType">
            <enum name="number" value="0" />
            <enum name="numberPassword" value="1" />
            <enum name="text" value="2" />
            <enum name="textPassword" value="3" />
        </attr>
        <attr name="vcv_et_width" format="dimension" />
        <attr name="vcv_et_height" format="dimension" />
        <attr name="vcv_et_text_color" format="color" />
        <attr name="vcv_et_text_size" format="dimension" />
        <attr name="vcv_et_bg" format="reference" />
        <attr name="vcv_et_bg_filled" format="reference" />
        <attr name="vcv_et_spacing" format="dimension" />
        <!-- true：等分间距填满宽度；false：固定 spacing + 固定格宽 -->
        <attr name="vcv_et_bisect" format="boolean" />
        <attr name="vcv_et_password_char" format="string" />
    </declare-styleable>

    <!-- 发帖选图九宫格（与 NineGridImageView 同包） -->
    <declare-styleable name="NinePicChooseView">
        <attr name="npc_maxCount" format="integer" />
        <attr name="npc_spanCount" format="integer" />
        <attr name="npc_itemGap" format="dimension" />
        <!-- 已选图圆角；未单独设 addCorner 时加号格沿用 -->
        <attr name="npc_cornerRadius" format="dimension" />
        <attr name="npc_deleteIcon" format="reference" />
        <attr name="npc_deleteIconSize" format="dimension" />
        <attr name="npc_showDelete" format="boolean" />

        <!-- 加号格 -->
        <attr name="npc_addIcon" format="reference" />
        <attr name="npc_addIconSize" format="dimension" />
        <attr name="npc_addIconTint" format="color" />
        <attr name="npc_addIconPadding" format="dimension" />
        <attr name="npc_addBgColor" format="color" />
        <attr name="npc_addCornerRadius" format="dimension" />
        <!-- 虚线边框 -->
        <attr name="npc_addBorderColor" format="color" />
        <attr name="npc_addBorderWidth" format="dimension" />
        <attr name="npc_addDashWidth" format="dimension" />
        <attr name="npc_addDashGap" format="dimension" />
        <!-- false 则实线边框（dashWidth/gap 忽略） -->
        <attr name="npc_addBorderDashed" format="boolean" />
    </declare-styleable>
</resources>