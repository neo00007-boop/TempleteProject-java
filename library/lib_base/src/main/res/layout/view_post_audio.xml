<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llPostAudioRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_post_audio"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/x24"
    android:paddingTop="@dimen/x20"
    android:paddingEnd="@dimen/x24"
    android:paddingBottom="@dimen/x20">

    <FrameLayout
        android:id="@+id/flPlayBtn"
        android:layout_width="@dimen/x90"
        android:layout_height="@dimen/x90"
        android:background="@drawable/bg_post_audio_play">

        <ImageView
            android:id="@+id/ivPlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="@dimen/x22"
            android:scaleType="centerInside"
            android:src="@drawable/ic_post_audio_play"
            tools:ignore="ImageContrastCheck" />

        <ImageView
            android:id="@+id/ivPause"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="@dimen/x22"
            android:scaleType="centerInside"
            android:src="@drawable/ic_post_audio_pause"
            android:visibility="gone"
            tools:ignore="ImageContrastCheck"
            tools:visibility="gone" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateTint="@color/white"
            android:padding="@dimen/x20"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/llWaveArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x20"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:includeFontPadding="false"
            android:textColor="@color/cl_999"
            android:textSize="@dimen/x28"
            tools:text="00:12 / 01:05" />

        <com.lib.base.ui.widget.audio.WaveformSeekBar
            android:id="@+id/waveformSeekBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x70"
            android:layout_marginTop="@dimen/x8" />
    </LinearLayout>
</LinearLayout>
