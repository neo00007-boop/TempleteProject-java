<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/x48">

    <com.skydoves.androidveil.VeilLayout
        android:id="@+id/sl1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/sl2"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:veilLayout_baseAlpha="1.0"
        app:veilLayout_baseColor="@color/shimmer_base"
        app:veilLayout_defaultChildVisible="true"
        app:veilLayout_dropOff="0.5"
        app:veilLayout_highlightAlpha="1.0"
        app:veilLayout_highlightColor="@color/shimmer_highlight"
        app:veilLayout_radius="12dp"
        app:veilLayout_shimmerEnable="true"
        app:veilLayout_veiled="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </com.skydoves.androidveil.VeilLayout>

    <com.skydoves.androidveil.VeilLayout
        android:id="@+id/sl2"
        android:layout_width="0dp"
        android:layout_height="@dimen/x36"
        android:layout_marginTop="@dimen/x16"
        android:layout_marginEnd="@dimen/x160"
        app:layout_constraintBottom_toTopOf="@id/view1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sl1"
        app:veilLayout_baseAlpha="1.0"
        app:veilLayout_baseColor="@color/shimmer_base"
        app:veilLayout_defaultChildVisible="true"
        app:veilLayout_dropOff="0.5"
        app:veilLayout_highlightAlpha="1.0"
        app:veilLayout_highlightColor="@color/shimmer_highlight"
        app:veilLayout_radius="6dp"
        app:veilLayout_shimmerEnable="true"
        app:veilLayout_veiled="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </com.skydoves.androidveil.VeilLayout>

    <View
        android:id="@+id/view1"
        android:layout_width="@dimen/x40"
        android:layout_height="@dimen/x40"
        android:layout_marginTop="@dimen/x16"
        android:background="@drawable/shimmer_dot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sl2" />

    <com.skydoves.androidveil.VeilLayout
        android:id="@+id/sl3"
        android:layout_width="0dp"
        android:layout_height="@dimen/x24"
        android:layout_marginStart="@dimen/x16"
        android:layout_marginEnd="@dimen/x240"
        app:layout_constraintBottom_toBottomOf="@id/view1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/view1"
        app:layout_constraintTop_toTopOf="@id/view1"
        app:veilLayout_baseAlpha="1.0"
        app:veilLayout_baseColor="@color/shimmer_base"
        app:veilLayout_defaultChildVisible="true"
        app:veilLayout_dropOff="0.5"
        app:veilLayout_highlightAlpha="1.0"
        app:veilLayout_highlightColor="@color/shimmer_highlight"
        app:veilLayout_radius="6dp"
        app:veilLayout_shimmerEnable="true"
        app:veilLayout_veiled="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </com.skydoves.androidveil.VeilLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
