<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/holder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- shimmer 骨架：仅 loadingMode=shimmer 时 inflate，默认不预加载 -->
    <com.lib.base.ui.widget.ShimmerView
        android:id="@+id/shimmer_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:shimmerAutoStart="false" />

    <!-- 居中状态：progress / 无数据 / 错误 -->
    <LinearLayout
        android:id="@+id/state_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.65" />

        <View
            android:id="@+id/holder_loading"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                android:id="@+id/loading_dialog"
                layout="@layout/loading_dialog"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/iv"
                android:layout_width="@dimen/x800"
                android:layout_height="@dimen/x800"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                tools:ignore="ContentDescription"
                tools:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-30dp"
            android:includeFontPadding="false"
            android:text="还没有收藏呐~"
            android:textColor="@color/cl_666"
            android:textSize="@dimen/x50"
            android:textStyle="normal"
            android:visibility="gone"
            tools:ignore="HardcodedText"
            tools:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.5" />
    </LinearLayout>
</FrameLayout>
